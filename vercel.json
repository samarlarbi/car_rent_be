{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/run-evening-reminders",
      "schedule": "3 20 * * *"
    },
    {
      "path": "/api/v1/cron/sync-status",
      "schedule": "0 * * * *"
    }
  ]
}