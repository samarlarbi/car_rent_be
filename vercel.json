{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/sync-car-status",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/v1/cron/check-overdue",
      "schedule": "10 19 * * *"
    }
  ]
}